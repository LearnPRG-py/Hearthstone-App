{
  "expo": {
    "name": "hearthstone-app",
    "slug": "hearthstone-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hearthstoneapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.hearthstoneapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-fast-tflite",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Hearthstone needs camera access for sign detection",
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hearthstone needs microphone access to transcribe speech",
          "speechRecognitionPermission": "Hearthstone needs speech recognition to turn speech into sign"
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
